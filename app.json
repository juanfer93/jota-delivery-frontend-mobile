{
  "expo": {
    "name": "jota-delivery-mobile",
    "slug": "jota-delivery-mobile",
    "version": "1.0.0",
    "platforms": [
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jotadeliverymobile",
    "userInterfaceStyle": "automatic",
    "extra": {
      "eas": {
        "projectId": "57d42d38-7913-4395-926e-44c211246990"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#174A8B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.jotadeliverymobile"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "openBrowserOnStart": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#174A8B",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 180
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#174A8B",
          "defaultChannel": "orders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

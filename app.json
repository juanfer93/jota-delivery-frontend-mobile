{
  "expo": {
    "name": "jota-delivery-mobile",
    "slug": "jota-delivery-mobile",
    "version": "1.0.1",
    "platforms": [
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/jota-delivery-logo-login-mark.png",
    "scheme": "jotadeliverymobile",
    "userInterfaceStyle": "automatic",
    "android": {
      "icon": "./assets/images/jota-delivery-logo-login-mark.png",
      "adaptiveIcon": {
        "backgroundColor": "#174A8B",
        "foregroundImage": "./assets/images/jota-delivery-logo-login-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jotadelivery.mobile",
      "versionCode": 3,
      "runtimeVersion": "1.0.1",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "openBrowserOnStart": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#174A8B",
          "image": "./assets/images/jota-delivery-logo-blue.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#174A8B",
            "image": "./assets/images/jota-delivery-logo-blue.png",
            "imageWidth": 200,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#174A8B",
          "defaultChannel": "orders-v3",
          "sounds": [
            "./assets/sounds/jota_notifications.mp3"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f3bb395c-fe1a-474a-9f6a-949b619e0d40"
      }
    },
    "ios": {
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "owner": "juanfer93",
    "updates": {
      "url": "https://u.expo.dev/f3bb395c-fe1a-474a-9f6a-949b619e0d40"
    }
  }
}

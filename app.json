{
  "expo": {
    "name": "jota-delivery-mobile",
    "slug": "jota-delivery-mobile",
    "owner": "juanfer93",
    "version": "1.0.0",
    "platforms": [
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/jota-delivery-logo-login-mark.png",
    "scheme": "jotadeliverymobile",
    "userInterfaceStyle": "automatic",
    "android": {
      "icon": "./assets/images/jota-delivery-logo-login-mark.png",
      "adaptiveIcon": {
        "backgroundColor": "#174A8B",
        "foregroundImage": "./assets/images/jota-delivery-logo-login-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jotadelivery.mobile",
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "openBrowserOnStart": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#174A8B",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 180
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#174A8B",
          "defaultChannel": "orders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c30edef-d7d7-4a3a-84be-fb170949d87a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/4c30edef-d7d7-4a3a-84be-fb170949d87a"
    },
    "ios": {
      "runtimeVersion": {
        "policy": "appVersion"
      }
    }
  }
}